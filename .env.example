# Cokonu — required environment variables (names only; NO secret values here).
# Copy to .env.local for local dev, and set the same keys in Netlify:
#   Project configuration → Environment variables.

# Live product catalog: Google Apps Script web app URL (the .../exec endpoint)
# that returns the catalog JSON. Read server-side only, in lib/catalog.ts via
# process.env.SHEETS_CATALOG_URL. Never commit the real value.
SHEETS_CATALOG_URL=
